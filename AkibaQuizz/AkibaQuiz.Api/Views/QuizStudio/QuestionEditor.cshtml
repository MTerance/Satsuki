@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using AkibaQuiz.Api.Admin
@model AkibaQuiz.Api.Admin.QuestionEditorVm
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Question" : "Create Question";
}

@using System.Text.Json

@{
    var mediaJson =
        !string.IsNullOrWhiteSpace(Model.MediaAssociationsJson)
        ? Model.MediaAssociationsJson
        : JsonSerializer.Serialize(
            Model.ExistingMedia.Select(m => new
            {
                idMedia = m.IdMedia,
                filename = m.Filename,
                typeDisplay = m.TypeDisplay
            }));
}

<div class="container-fluid">
    <h1>@ViewData["Title"]</h1>

    <form method="post" action="@Url.Action("SaveQuestion", "QuizStudio")">
        @Html.AntiForgeryToken()
        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div class="text-danger">
            @Html.ValidationSummary(false)
        </div>

        <div class="mb-3">
            <label class="form-label"
                   for="question">
                Énoncé
            </label>

            <textarea id="question"
                      name="Question"
                      class="form-control"
                      rows="3"
                      required
                      minlength="3">@Model.Question</textarea>

            @Html.ValidationMessageFor(m => m.Question)
        </div>

        <div class="mb-3">
            <label class="form-label"
                   for="answer">
                Réponse attendue
            </label>

            <textarea id="answer"
                      name="Answer"
                      class="form-control"
                      rows="3"
                      required>@Model.Answer</textarea>

            @Html.ValidationMessageFor(m => m.Answer)
        </div>

        <div class="mb-3">
            <label class="form-label"
                   for="category">
                Catégorie
            </label>

            <select id="category"
                    name="IdCategory"
                    class="form-select"
                    required>

                <option value="0">Sélectionner...</option>

                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id"
                            selected="@(category.Id == Model.IdCategory)">
                        @category.Name
                    </option>
                }
            </select>

            @Html.ValidationMessageFor(m => m.IdCategory)
        </div>

        <fieldset class="mb-3">
            <legend class="h5">Tags</legend>

            @foreach (var tag in Model.AvailablesTags)
            {
                <label class="form-check form-check-inline">
                    <input type="checkbox"
                           class="form-check-input"
                           name="TagIds"
                           value="@tag.Id"
                           checked="@(Model.TagsId.Contains(tag.Id))" />

                    <span class="form-check-label">
                        @tag.Name
                    </span>
                </label>
            }
        </fieldset>

        @if (Model.ExistingMedia.Count > 0)
        {
            <div class="alert alert-info">
                Les médias associés seront conservés.
                Leur modification sera ajoutée dans
                un prochain TP.
            </div>

            <ul>
                @foreach (var media in Model.ExistingMedia)
                {
                    <li>@media.Filename (@media.TypeDisplay)</li>
                }
            </ul>
        }
        
        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Medias associes</h2>

                <p class="text-muted">Sélectionnez les médias à associer à ce jeu.</p>


                <input type="hidden"
                       id="akibaMediaAssociationsJson"
                       name="MediaAssociationsJson"
                       value="@mediaJson" />

                <div id="akibaMediaAssociationList"
                     class="mt-3">
                </div>
                <button type="button" id="akibaOpenMedia" class="btn btn-outline-primary" disabled>
                    + Ajouter un média
                </button>
                <div id="akibaSelectedMediaPreview" class="mt-3">
                </div>
            </div>
        </section>


        <div class="mt-4">
            <button type="submit"
                    class="btn btn-primary">
                Enregistrer
            </button>

            <a class="btn btn-secondary"
               href="@Url.Action("Index", "QuizStudio",
                   new { area = "AkibaQuiz.Api" })">
                Annuler
            </a>
        </div>
    </form>
    @await Html.PartialAsync("_AkibaMediaPicker")
</div>