@model AkibaQuiz.Api.Admin.GameEditorVm
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Game" : "Create Game";
}

<div class="container-fluid" style="max-width: 1100px;">

    <h1>@ViewData["Title"]</h1>

    <div class="alert alert-info">
        Étape 5.3.5.2 :
        composition des manches et questions.
        L'enregistrement sera ajouté ultérieurement.
    </div>

    <div class="mb-4">
        <label for="gameName" class="form-label">
            Nom du Game
        </label>

        <input id="gameName"
               class="form-control"
               value="@Model.Name"
               minlength="2"
               maxlength="200" />
    </div>
    <h2 class="h4">Manches et questions</h2>

    <div id="gameRounds">

        @foreach (var round in Model.Rounds)
        {
            <article class="game-round card mb-3"
                     data-round-id="@round.Id">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-2 mb-3">

                        <h3 class="h5 round-title flex-grow-1">
                            Manche @round.Position
                        </h3>

                        <span class="round-count badge bg-secondary">
                            @round.QuestionCount question(s)
                        </span>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-action="up-round"
                                title="Monter la manche">
                            ↑
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-action="down-round"
                                title="Descendre la manche">
                            ↓
                        </button>

                        <button type="button"
                                class="btn btn-outline-danger"
                                data-action="remove-round">
                            Retirer
                        </button>
                    </div>

                    <div class="round-question-list mb-3">

                        @foreach (var question in round.Questions)
                        {
                            var questionId = question.TypeQuestion == "QCM" 
                            ? question.QcmQuestionId 
                            : question.QuestionId;
                            <div class="game-question border rounded p-2 mb-2"
                                 data-entry-id="@questionId"
                                 data-type="@question.TypeQuestion"
                                 data-question-id="@questionId">

                                <div class="d-flex align-items-center gap-2">

                                    <span class="question-number"></span>

                                    <span class="question-label flex-grow-1">
                                        [@question.TypeQuestion] @question.Label
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-action="up-question"
                                            title="Monter la question">
                                        ↑
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-action="down-question"
                                            title="Descendre la question">
                                        ↓
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-action="remove-question">
                                        ×
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="input-group">

                        <div class="mt-2">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    data-action="open-picker">
                                + Rechercher et ajouter une question
                            </button>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <button type="button"
            id="addRound"
            class="btn btn-outline-primary mb-4">
        + Ajouter une manche
    </button>

    <h2 class="h5">Prévisualisation JSON</h2>

    <pre id="gamePreview"
         class="border rounded p-3"
         style="max-height: 350px; overflow: auto;">
    </pre>

    <div id="saveGameFeedback"
         class="mb-3"
         role="alert"
         aria-live="polite"></div>

    <form id="saveGameForm"
          method="post"
          action="@Url.Action(
              "SaveGame",
              "QuizStudio",
              new { area = "AkibaQuiz.Api" })">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <input type="hidden"
               name="Revision"
               value="@Model.Revision" />

        <input type="hidden"
               name="Payload"
               id="gamePayload" />

        <button type="submit"
                id="saveGameButton"
                class="btn btn-primary">
            Enregistrer le Game
        </button>
    </form>


    <a class="btn btn-secondary"
       href="@Url.Action(
           "Index",
           "QuizStudio",
           new { area = "AkibaQuiz.Api" })">
        Retour à la banque de contenu
    </a>
</div>

<!-- Modèle HTML : nouvelle manche -->
<dialog id="gameQuestionDialog"
        data-search-url="@Url.Action(
            "GameQuestionSearch",
            "QuizStudio",
            new { area = "AkibaQuiz.Api" })"
        class="border rounded shadow p-4"
        style="width: min(95vw, 900px);
    max-height: 85vh;">

    <div class="d-flex justify-content-between
        align-items-center mb-3">
        <h2 class="h5 mb-0">
            Ajouter une question
        </h2>

        <form method="dialog">
            <button type="submit"
                    class="btn btn-sm btn-outline-secondary">
                Fermer
            </button>
        </form>
    </div>

    <div class="row g-2 mb-3">

        <div class="col-12">
            <label for="pickerText" class="form-label">
                Rechercher un énoncé
            </label>
            <input id="pickerText"
                   type="search"
                   class="form-control"
                   maxlength="160"
                   placeholder="Saisir un texte..." />
        </div>

        <div class="col-md-4">
            <label for="pickerKind" class="form-label">
                Type
            </label>
            <select id="pickerKind" class="form-select">
                <option value="All">Tous</option>
                <option value="QuestionAnswer">
                    QuestionAnswer
                </option>
                <option value="QCM">QCM</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="pickerCategory" class="form-label">
                Catégorie
            </label>
            <select id="pickerCategory" class="form-select">
                <option value="">Toutes</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label for="pickerTag" class="form-label">
                Tag
            </label>
            <select id="pickerTag" class="form-select">
                <option value="">Tous</option>
                @foreach (var tag in Model.Tags)
                {
                    <option value="@tag.Id">
                        @tag.Name
                    </option>
                }
            </select>
        </div>

    </div>

    <p id="pickerStatus"
       class="text-muted"
       role="status"
       aria-live="polite"></p>

    <ul id="pickerResults"
        class="list-group mb-3"></ul>

    <div class="d-flex justify-content-between
        align-items-center gap-2">

        <button type="button"
                id="pickerPrevious"
                class="btn btn-outline-secondary">
            Précédente
        </button>

        <span id="pickerPageLabel"></span>

        <button type="button"
                id="pickerNext"
                class="btn btn-outline-secondary">
            Suivante
        </button>

    </div>
</dialog>

<template id="roundTemplate">

    <article class="game-round card mb-3"
             data-round-id="0">

        <div class="card-body">

            <div class="d-flex align-items-center gap-2 mb-3">

                <h3 class="h5 round-title flex-grow-1"></h3>

                <span class="round-count badge bg-secondary">
                    0 question(s)
                </span>

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-action="up-round">
                    ↑
                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-action="down-round">
                    ↓
                </button>

                <button type="button"
                        class="btn btn-outline-danger"
                        data-action="remove-round">
                    Retirer
                </button>
            </div>

            <div class="round-question-list mb-3"></div>

            <div class="input-group">

                <div class="mt-2">
                    <button type="button"
                            class="btn btn-outline-primary"
                            data-action="open-picker">
                        + Rechercher et ajouter une question
                    </button>
                </div>
            </div>
        </div>
    </article>
</template>

<!-- Modèle HTML : nouvelle question -->

<template id="questionTemplate">

    <div class="game-question border rounded p-2 mb-2"
         data-entry-id="0">

        <div class="d-flex align-items-center gap-2">

            <span class="question-number"></span>

            <span class="question-label flex-grow-1"></span>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-action="up-question">
                ↑
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-action="down-question">
                ↓
            </button>

            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-action="remove-question">
                ×
            </button>
        </div>
    </div>
</template>

<hr />


<script>
    (() => {
        "use strict";

        // =====================================================
        // 1. INITIALISATION
        // =====================================================

        const container = document.getElementById("gameRounds");
        const roundTemplate = document.getElementById("roundTemplate");
        const questionTemplate = document.getElementById("questionTemplate");

        const addRoundButton = document.getElementById("addRound");
        const gameName = document.getElementById("gameName");
        const preview = document.getElementById("gamePreview");

        const saveForm = document.getElementById("saveGameForm");
        const saveButton = document.getElementById("saveGameButton");
        const payloadInput = document.getElementById("gamePayload");
        const feedback = document.getElementById("saveGameFeedback");

        const requiredElements = {
            container,
            roundTemplate,
            questionTemplate,
            addRoundButton,
            gameName,
            preview,
            saveForm,
            saveButton,
            payloadInput,
            feedback
        };

        for (const [name, element] of Object.entries(requiredElements)) {
            if (!element) {
                console.error(
                    `GameEditor : élément HTML manquant : ${name}`
                );
                return;
            }
        }

        // =====================================================
        // 2. ACCÈS AUX MANCHES ET QUESTIONS
        // =====================================================

        function getRounds() {
            return [...container.children]
                .filter(element =>
                    element.classList.contains("game-round")
                );
        }

        function getQuestionList(round) {
            return round.querySelector(".round-question-list");
        }

        function getQuestions(round) {
            const list = getQuestionList(round);

            if (!list) {
                throw new Error(
                    "Une manche ne possède pas de liste de questions."
                );
            }

            return [...list.children]
                .filter(element =>
                    element.classList.contains("game-question")
                );
        }

        // =====================================================
        // 3. GESTION DES MESSAGES
        // =====================================================

        function showError(message) {
            feedback.textContent = message;
            feedback.className = "alert alert-danger mb-3";
        }

        function clearMessage() {
            feedback.textContent = "";
            feedback.className = "mb-3";
        }

        function showSuccess(message) {
            feedback.textContent = message;
            feedback.className = "alert alert-success mb-3";
        }

        // =====================================================
        // 4. CONSTRUCTION DU SAVE GAME REQUEST
        // =====================================================

        function buildGameRequest() {
            const rounds = getRounds();

            return {
                name: gameName.value.trim(),

                rounds: rounds.map((round, roundIndex) => {
                    const questions = getQuestions(round);

                    return {
                        position: roundIndex + 1,

                        questions: questions.map(
                            (question, questionIndex) => {

                                const type = question.dataset.type;

                                const questionId = Number(
                                    question.dataset.questionId
                                );

                                if (
                                    !Number.isSafeInteger(questionId) ||
                                    questionId <= 0
                                ) {
                                    throw new Error(
                                        `Identifiant invalide : ` +
                                        `manche ${roundIndex + 1}, ` +
                                        `question ${questionIndex + 1}.`
                                    );
                                }

                                const entry = {
                                    position: questionIndex + 1
                                };

                                if (type === "QuestionAnswer") {
                                    entry.idQuestionAnswer = questionId;
                                }
                                else if (type === "QCM") {
                                    entry.idQCMQuestion = questionId;
                                }
                                else {
                                    throw new Error(
                                        `Type de question inconnu : ${type}`
                                    );
                                }

                                return entry;
                            }
                        )
                    };
                })
            };
        }

        // =====================================================
        // 5. ACTUALISATION DE L'INTERFACE
        // =====================================================

        function refresh() {
            const rounds = getRounds();

            rounds.forEach((round, roundIndex) => {
                const questions = getQuestions(round);

                // Numérotation des manches
                round.querySelector(".round-title")
                    .textContent = `Manche ${roundIndex + 1}`;

                round.querySelector(".round-count")
                    .textContent = `${questions.length} question(s)`;

                // Boutons des manches
                round.querySelector('[data-action="up-round"]')
                    .disabled = roundIndex === 0;

                round.querySelector('[data-action="down-round"]')
                    .disabled = roundIndex === rounds.length - 1;

                round.querySelector('[data-action="remove-round"]')
                    .disabled =
                    rounds.length <= 1 ||
                    questions.length > 0;

                // Numérotation et boutons des questions
                questions.forEach((question, questionIndex) => {
                    question.querySelector(".question-number")
                        .textContent = `${questionIndex + 1}.`;

                    question.querySelector(
                        '[data-action="up-question"]'
                    ).disabled = questionIndex === 0;

                    question.querySelector(
                        '[data-action="down-question"]'
                    ).disabled =
                        questionIndex === questions.length - 1;
                });
            });

            // Prévisualisation du JSON
            console.log("GameEditor - Prévisualisation JSON :", buildGameRequest());
            try {
                preview.textContent = JSON.stringify(
                    buildGameRequest(),
                    null,
                    2
                );
            }
            catch (error) {
                console.error("GameEditor - Erreur de prévisualisation JSON :", error);
                preview.textContent =
                    `Erreur dans la composition : ${error.message}`;
            }
        }

        // =====================================================
        // 6. AJOUT D'UNE MANCHE
        // =====================================================

        addRoundButton.addEventListener("click", () => {
            const newRound = roundTemplate.content
                .firstElementChild
                .cloneNode(true);

            container.appendChild(newRound);

            refresh();
            clearMessage();
        });

        // =====================================================
        // 7. MODIFICATION DU NOM DU GAME
        // =====================================================

        gameName.addEventListener("input", () => {
            refresh();
            clearMessage();
        });

        // =====================================================
        // 8. ACTIONS SUR LES MANCHES ET QUESTIONS
        // =====================================================

        const pickerDialog =
            document.getElementById("gameQuestionDialog");

        const pickerText =
            document.getElementById("pickerText");

        const pickerKind =
            document.getElementById("pickerKind");

        const pickerCategory =
            document.getElementById("pickerCategory");

        const pickerTag =
            document.getElementById("pickerTag");

        const pickerStatus =
            document.getElementById("pickerStatus");

        const pickerResults =
            document.getElementById("pickerResults");

        const pickerPrevious =
            document.getElementById("pickerPrevious");

        const pickerNext =
            document.getElementById("pickerNext");

        const pickerPageLabel =
            document.getElementById("pickerPageLabel");

        let targetRound = null;
        let pickerPage = 1;
        let pickerTotalPages = 0;
        let pickerAbort = null;
        let searchTimer = null;

        function openQuestionPicker(round) {
            targetRound = round;
            pickerPage = 1;

            pickerDialog.showModal();
            pickerText.focus();

            loadQuestionPage();
        }

        async function loadQuestionPage() {
            // Annuler l'ancienne recherche lorsque
            // l'utilisateur modifie les filtres.
            pickerAbort?.abort();
            pickerAbort = new AbortController();

            const parameters = new URLSearchParams({
                Kind: pickerKind.value,
                Page: String(pickerPage),
                PageSize: "25"
            });

            const text = pickerText.value.trim();

            if (text)
                parameters.set("Text", text);

            if (pickerCategory.value)
                parameters.set(
                    "CategoryId",
                    pickerCategory.value
                );

            if (pickerTag.value)
                parameters.set("TagId", pickerTag.value);

            pickerStatus.textContent = "Recherche en cours...";
            pickerResults.replaceChildren();

            try {
                const response = await fetch(
                    pickerDialog.dataset.searchUrl +
                    "?" + parameters.toString(),
                    {
                        method: "GET",
                        credentials: "same-origin",
                        headers: {
                            "Accept": "application/json"
                        },
                        signal: pickerAbort.signal
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        `La recherche a échoué : HTTP ${response.status}`
                    );
                }

                const result = await response.json();

                pickerTotalPages = result.totalPages;

                pickerStatus.textContent =
                    `${result.totalCount} question(s) trouvée(s)`;

                pickerPageLabel.textContent =
                    `Page ${pickerPage} / ` +
                    `${Math.max(1, pickerTotalPages)}`;

                pickerPrevious.disabled =
                    pickerPage <= 1;

                pickerNext.disabled =
                    pickerPage >= pickerTotalPages;

                for (const item of result.items) {
                    const row =
                        document.createElement("li");

                    row.className =
                        "list-group-item d-flex " +
                        "justify-content-between " +
                        "align-items-center gap-3";

                    const textBlock =
                        document.createElement("div");

                    textBlock.className = "flex-grow-1";

                    const title =
                        document.createElement("div");

                    title.className = "fw-semibold";
                    title.textContent = item.question;

                    const details =
                        document.createElement("small");

                    details.className = "text-muted";
                    details.textContent =
                        `${item.type} #${item.id} · ` +
                        item.categoryName;

                    textBlock.append(title, details);

                    const addButton =
                        document.createElement("button");

                    addButton.type = "button";
                    addButton.className =
                        "btn btn-sm btn-outline-primary";

                    addButton.textContent = "Ajouter";

                    addButton.dataset.type = item.type;
                    addButton.dataset.id = String(item.id);
                    addButton.dataset.label = item.question;

                    row.append(textBlock, addButton);
                    pickerResults.appendChild(row);
                }
            }
            catch (error) {
                if (error.name === "AbortError")
                    return;

                console.error("GameQuestionSearch", error);

                pickerStatus.textContent =
                    "Erreur lors de la recherche : " +
                    error.message;
            }
        }

        // Rechercher après une courte pause de saisie.
        pickerText.addEventListener("input", () => {
            clearTimeout(searchTimer);

            searchTimer = setTimeout(() => {
                pickerPage = 1;
                loadQuestionPage();
            }, 300);
        });

        // Les autres filtres rechargent immédiatement.
        for (const element of [
            pickerKind,
            pickerCategory,
            pickerTag
        ]) {
            element.addEventListener("change", () => {
                pickerPage = 1;
                loadQuestionPage();
            });
        }

        pickerPrevious.addEventListener("click", () => {
            if (pickerPage > 1) {
                pickerPage--;
                loadQuestionPage();
            }
        });

        pickerNext.addEventListener("click", () => {
            if (pickerPage < pickerTotalPages) {
                pickerPage++;
                loadQuestionPage();
            }
        });

        // =====================================================
        // AJOUT À LA MANCHE CIBLE
        // =====================================================

        pickerResults.addEventListener("click", event => {
            if (!(event.target instanceof Element))
                return;

            const button = event.target.closest(
                "button[data-id][data-type]"
            );

            if (!button || !targetRound)
                return;

            const type = button.dataset.type;
            const id = Number(button.dataset.id);
            const label = button.dataset.label;

            if (
                !["QuestionAnswer", "QCM"].includes(type) ||
                !Number.isSafeInteger(id) ||
                id <= 0
            ) {
                showError("Référence de question invalide.");
                return;
            }

            const exists = getQuestions(targetRound).some(
                question =>
                    question.dataset.type === type &&
                    Number(question.dataset.questionId) === id
            );

            if (exists) {
                pickerStatus.textContent =
                    "Cette question est déjà présente " +
                    "dans cette manche.";
                return;
            }

            const newQuestion = questionTemplate.content
                .firstElementChild
                .cloneNode(true);

            newQuestion.dataset.entryId = "0";
            newQuestion.dataset.type = type;
            newQuestion.dataset.questionId = String(id);

            newQuestion.querySelector(".question-label")
                .textContent = `[${type}] ${label}`;

            getQuestionList(targetRound)
                .appendChild(newQuestion);

            refresh();
            clearMessage();
            pickerDialog.close();
        });

        pickerDialog.addEventListener("close", () => {
            pickerAbort?.abort();
            clearTimeout(searchTimer);
            targetRound = null;
        });

        container.addEventListener("click", event => {
            if (!(event.target instanceof Element))
                return;

            const button = event.target.closest(
                "button[data-action]"
            );

            if (!button || !container.contains(button))
                return;

            const action = button.dataset.action;

            const round = button.closest(".game-round");

            if (!round)
                return;

            const questionList = getQuestionList(round);

            // ---------------------------------------------
            // AJOUTER UNE QUESTION
            // ---------------------------------------------

            if (action === "open-picker") {
                openQuestionPicker(round);
                return;
            }

            // ---------------------------------------------
            // MONTER UNE MANCHE
            // ---------------------------------------------

            if (action === "up-round") {
                const previous = round.previousElementSibling;

                if (previous) {
                    container.insertBefore(round, previous);
                }
            }

            // ---------------------------------------------
            // DESCENDRE UNE MANCHE
            // ---------------------------------------------

            if (action === "down-round") {
                const next = round.nextElementSibling;

                if (next) {
                    container.insertBefore(next, round);
                }
            }

            // ---------------------------------------------
            // RETIRER UNE MANCHE VIDE
            // ---------------------------------------------

            if (action === "remove-round") {
                if (
                    getRounds().length <= 1 ||
                    getQuestions(round).length > 0
                ) {
                    return;
                }

                round.remove();
            }

            // ---------------------------------------------
            // ACTIONS SUR UNE QUESTION
            // ---------------------------------------------

            const question = button.closest(".game-question");

            if (question) {

                // Monter la question
                if (action === "up-question") {
                    const previous = question.previousElementSibling;

                    if (previous) {
                        questionList.insertBefore(
                            question,
                            previous
                        );
                    }
                }

                // Descendre la question
                if (action === "down-question") {
                    const next = question.nextElementSibling;

                    if (next) {
                        questionList.insertBefore(
                            next,
                            question
                        );
                    }
                }

                // Retirer la question
                if (action === "remove-question") {
                    question.remove();
                }
            }

            refresh();
            clearMessage();
        });

        // =====================================================
        // 9. VALIDATION AVANT ENREGISTREMENT
        // =====================================================

        function validateGame(request) {

            if (request.name.length < 2) {
                throw new Error(
                    "Le nom du Game doit contenir au moins 2 caractères."
                );
            }

            if (request.rounds.length === 0) {
                throw new Error(
                    "Le Game doit contenir au moins une manche."
                );
            }

            for (const round of request.rounds) {
                if (round.questions.length === 0) {
                    throw new Error(
                        `La manche ${round.position} est vide.`
                    );
                }

                const seen = new Set();

                for (const question of round.questions) {
                    const type = question.idQCMQuestion != null
                        ? "QCM"
                        : "QuestionAnswer";

                    const id = question.idQCMQuestion
                        ?? question.idQuestionAnswer;

                    const key = `${type}:${id}`;

                    if (seen.has(key)) {
                        throw new Error(
                            `Question dupliquée dans la manche ` +
                            `${round.position}.`
                        );
                    }

                    seen.add(key);
                }
            }
        }

        // =====================================================
        // 10. ENREGISTREMENT DU GAME
        // =====================================================

        saveForm.addEventListener("submit", async event => {
            event.preventDefault();

            if (saveButton.disabled)
                return;

            clearMessage();

            let request;

            try {
                // Construire et valider toute la composition
                request = buildGameRequest();

                validateGame(request);
            }
            catch (error) {
                showError(error.message);
                return;
            }

            // ---------------------------------------------
            // IMPORTANT : renseigner Payload AVANT FormData
            // ---------------------------------------------

            const payload = JSON.stringify(request);

            payloadInput.value = payload;

            const formData = new FormData(saveForm);

            // Garantir la présence du JSON dans FormData
            formData.set("Payload", payload);

            const gameId = formData.get("Id");
            const revision = formData.get("Revision");

            // ---------------------------------------------
            // Contrôle de Revision pour une modification
            // ---------------------------------------------

            if (gameId && !revision) {
                showError(
                    "L'empreinte Revision du Game existant est absente. " +
                    "Recharge la page avant d'enregistrer."
                );
                return;
            }

            // ---------------------------------------------
            // Diagnostic dans la console du navigateur
            // ---------------------------------------------

            console.debug("SaveGame - ID :", gameId);
            console.debug("SaveGame - Revision :", revision);
            console.debug("SaveGame - Payload :", payload);

            saveButton.disabled = true;
            saveButton.textContent = "Enregistrement...";

            try {
                // -----------------------------------------
                // Envoi POST MVC avec jeton antiforgery
                // -----------------------------------------

                const response = await fetch(saveForm.action, {
                    method: "POST",
                    body: formData,
                    credentials: "same-origin",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                // -----------------------------------------
                // Lecture de la réponse
                // -----------------------------------------

                const contentType =
                    response.headers.get("content-type") ?? "";

                let result = null;

                if (contentType.includes("json")) {
                    result = await response.json();
                }

                // -----------------------------------------
                // Gestion des erreurs HTTP
                // -----------------------------------------

                if (!response.ok) {
                    let errorMessage =
                        result?.error ??
                        result?.title ??
                        `Erreur HTTP ${response.status}.`;

                    if (result?.errors) {
                        const details = Object.entries(result.errors)
                            .flatMap(([field, errors]) =>
                                errors.map(e => `${field} : ${e}`)
                            );

                        if (details.length > 0) {
                            errorMessage = details.join("\n");
                        }
                    }

                    console.error("SaveGame :", result);

                    showError(errorMessage);
                    return;
                }

                // -----------------------------------------
                // Vérification de la réponse du serveur
                // -----------------------------------------

                if (!result?.redirectUrl) {
                    showError(
                        "Le serveur n'a pas retourné l'URL du Game enregistré."
                    );
                    return;
                }

                showSuccess("Game enregistré avec succès.");

                // -----------------------------------------
                // Recharger depuis SQLite
                // -----------------------------------------

                window.location.assign(result.redirectUrl);
            }
            catch (error) {
                console.error("SaveGame :", error);

                showError(
                    "Erreur de communication avec le serveur : " +
                    error.message
                );
            }
            finally {
                saveButton.disabled = false;
                saveButton.textContent = "Enregistrer le Game";
            }
        });

        // =====================================================
        // 11. INITIALISATION
        // =====================================================

        refresh();

    })();
</script>

